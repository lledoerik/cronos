<?xml version="1.0" encoding="utf-8"?>
<!-- El favicon es mostra centrat i redimit (amb marges), perquè el logo
     no ompli tota la icona sense haver de retallar la imatge. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="26dp"
    android:insetTop="26dp"
    android:insetRight="26dp"
    android:insetBottom="26dp">
    <bitmap
        android:src="@drawable/favicon"
        android:gravity="fill" />
</inset>